# Language bar: GitHub's Linguist hides AsciiDoc twice over. It classifies
# AsciiDoc as prose, and it treats a top-level docs/ folder as documentation.
# In a documentation repository, both are the actual content, so count them.
*.adoc linguist-detectable=true
docs/** linguist-documentation=false

# Shell scripts must keep LF endings, also when checked out on Windows
*.sh text eol=lf
